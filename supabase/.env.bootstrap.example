# SERVER-SIDE EDGE FUNCTION SECRETS ONLY. Never copy these to a VITE_* variable.
DEV_ADMIN_REGISTRATION_ENABLED=false
DEV_ADMIN_BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
DEV_ADMIN_ALLOWED_ORIGIN=http://localhost:5173
# Set a short-lived future UTC timestamp, e.g. one hour from setup.
DEV_ADMIN_EXPIRES_AT=replace-with-ISO-UTC-timestamp
